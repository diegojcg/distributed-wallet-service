              "    });",
              "    console.log(\"Scenario wallet\", {walletId:w.id, balance, version, entries, replicas:urls.length});",
              "  }",
              "",
              "  const w=await wallet();",
              "  const first=operation(w,\"BET\",\"25.00\");",
              "  const second=JSON.parse(JSON.stringify(first));second.money.amount=\"30.00\";",
              "  const ops=[first,second];",
              "  const results=await Promise.all(ops.map((op,i)=>wager(op,i)));",
              "  pm.test(\"One processing result and one conflict\",()=>{",
              "    pm.expect(results.map(r=>r.code).sort()).to.deep.eql([200,409]);",
              "    pm.expect(results.find(r=>r.code===409).body.code).to.eql(\"CONFLICT\");",
              "  });",
              "  const winner=results.findIndex(r=>r.code===200);",
              "  if(winner<0) throw new Error(\"No winner\");",
              "  const balance=winner===0?\"75.00\":\"70.00\";",
              "  const replay=await wager(ops[winner]);",
              "  status(replay,200,\"Winner replay\");",
              "  pm.test(\"Winning result persisted\",()=>{pm.expect(replay.body.idempotentReplay).to.eql(true);pm.expect(replay.body.transactionId).to.eql(results[winner].body.transactionId);});",
              "  status(await wager(ops[1-winner]),409,\"Losing payload remains conflicting\");",
              "  await verify(w,balance,2,2);",
              "",
              "})().catch(error => {",
              "  pm.test(\"Scenario completed without execution errors\", () => { throw error; });",
              "});"
            ]
          }
        }
      ]
    },
