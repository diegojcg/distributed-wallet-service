              "  const second=JSON.parse(JSON.stringify(first));second.money.amount=\"30.00\";",
              "  const ops=[first,second];",
              "  const results=await Promise.all(ops.map((op,i)=>wager(op,i)));",
              "  pm.test(\"Um processamento e um conflito\",()=>{",
              "    pm.expect(results.map(r=>r.code).sort()).to.deep.eql([200,409]);",
              "    pm.expect(results.find(r=>r.code===409).body.code).to.eql(\"CONFLICT\");",
              "  });",
              "  const winner=results.findIndex(r=>r.code===200);",
              "  if(winner<0) throw new Error(\"Nenhum vencedor\");",
              "  const balance=winner===0?\"75.00\":\"70.00\";",
              "  const replay=await wager(ops[winner]);",
              "  status(replay,200,\"Replay do vencedor\");",
              "  pm.test(\"Resultado vencedor persistido\",()=>{pm.expect(replay.body.idempotentReplay).to.eql(true);pm.expect(replay.body.transactionId).to.eql(results[winner].body.transactionId);});",
