{
  "info": {
    "_postman_id": "2793ce70-9954-4fbb-804f-8962460c47d5",
    "name": "Jungle Wallet — concorrência HTTP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Use o environment Jungle Wallet local existente. Cada item cria carteiras próprias, dispara requisições HTTP em paralelo via pm.sendRequest/Promise.all e verifica o estado final. Pode usar Send ou Run collection com 1–5 iterações. replicaUrls é opcional: lista de URLs separadas por vírgula; sem ela usa baseUrl. São testes de correção sob disputa, não um benchmark: o GET de health é somente o ponto de partida, a carga real está no script após a resposta. Veja o Console e os resultados dos testes. Cria 12 carteiras por iteração e não apaga dados. Não usa os IDs da collection manual nem interrompe dependências."
  },
  "variable": [
    {
      "key": "replicaUrls",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Duas apostas de 80 sobre saldo 100",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready",
        "auth": {
          "type": "noauth"
        },
        "description": "Clique Send para executar o cenário inteiro. O script após a resposta faz autenticação, preparação, envio paralelo e verificações. Consulte Test Results e Console."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API pronta\", () => pm.response.to.have.status(200));",
              "(async function () {",
              "  const base = pm.environment.get(\"baseUrl\");",
              "  const urls = (pm.variables.get(\"replicaUrls\") || base).split(\",\").map(x => x.trim().replace(/\\/$/, \"\")).filter(Boolean);",
              "  const guid = () => pm.variables.replaceIn(\"{{$guid}}\");",
              "  function send(url, method, token, body, key) {",
              "    const header = {};",
              "    if (token) header.Authorization = \"Bearer \" + token;",
              "    if (body !== undefined) header[\"Content-Type\"] = \"application/json\";",
              "    if (key) header[\"Idempotency-Key\"] = key;",
              "    const request = {url, method, header};",
              "    if (body !== undefined) request.body = {mode:\"raw\", raw:JSON.stringify(body)};",
              "    return new Promise((resolve, reject) => pm.sendRequest(request, (err, response) => {",
              "      if (err) return reject(err);",
              "      try { resolve({code:response.code, body:response.json()}); } catch (e) { reject(e); }",
              "    }));",
              "  }",
              "  async function token(client, secretKey) {",
              "    return new Promise((resolve, reject) => pm.sendRequest({",
              "      url: pm.environment.get(\"keycloakUrl\") + \"/realms/jungle/protocol/openid-connect/token\",",
              "      method:\"POST\", header:{\"Content-Type\":\"application/x-www-form-urlencoded\"},",
              "      body:{mode:\"urlencoded\", urlencoded:[",
              "        {key:\"grant_type\",value:\"client_credentials\"},",
              "        {key:\"client_id\",value:client},",
              "        {key:\"client_secret\",value:pm.environment.get(secretKey)}",
              "      ]}",
              "    }, (err, response) => {",
              "      if (err) return reject(err);",
              "      if (response.code !== 200) return reject(new Error(\"Token \" + client + \": HTTP \" + response.code));",
              "      try { const value=response.json().access_token; if(!value) throw new Error(\"Token ausente\"); resolve(value); } catch(e) { reject(e); }",
              "    }));",
              "  }",
              "  const [internal, provider] = await Promise.all([",
              "    token(\"wallet-internal\", \"internalClientSecret\"), token(\"provider-a\", \"providerClientSecret\")",
              "  ]);",
              "  function status(response, expected, label) {",
              "    pm.test(label, () => pm.expect(response.code).to.eql(expected));",
              "    if (response.code !== expected) throw new Error(label + \": HTTP \" + response.code + \" \" + JSON.stringify(response.body));",
              "  }",
              "  async function wallet() {",
              "    const playerId=guid();",
              "    const response=await send(urls[0]+\"/wallets\", \"POST\", internal, {playerId, initialBalance:{amount:\"100.00\",currency:\"BRL\"}});",
              "    status(response,201,\"Carteira criada\");",
              "    return {id:response.body.id, playerId};",
              "  }",
              "  function operation(w, kind, amount, reference) {",
              "    const op={providerId:\"provider-a\",externalTransactionId:guid(),playerId:w.playerId,walletId:w.id,roundId:\"concurrency-round\",gameId:\"concurrency-game\",kind,money:{amount,currency:\"BRL\"}};",
              "    if(reference) op.referenceExternalTransactionId=reference;",
              "    return op;",
              "  }",
              "  function wager(op, index=0, key=op.externalTransactionId) {",
              "    return send(urls[index%urls.length]+\"/wagering/transactions\",\"POST\",provider,op,key);",
              "  }",
              "  async function verify(w, balance, version, entries) {",
              "    const results = await Promise.all(urls.map(url => send(url+\"/wallets/\"+w.id,\"GET\",internal)));",
              "    results.forEach((r,i) => {",
              "      status(r,200,\"Consulta na réplica \"+(i+1));",
              "      pm.test(\"Saldo e versão na réplica \"+(i+1), () => {",
              "        pm.expect(r.body.balance).to.deep.eql({amount:balance,currency:\"BRL\"});",
              "        pm.expect(r.body.version).to.eql(version);",
              "      });",
              "    });",
              "    const ledger=await send(urls[0]+\"/wallets/\"+w.id+\"/ledger?limit=100\",\"GET\",internal);",
              "    status(ledger,200,\"Ledger disponível\");",
              "    pm.test(\"Ledger sem duplicação e soma correta\", () => {",
              "      pm.expect(ledger.body.entries).to.have.length(entries);",
              "      pm.expect(ledger.body.nextCursor).to.be.undefined;",
              "      pm.expect(new Set(ledger.body.entries.map(e=>e.transactionId)).size).to.eql(entries);",
              "      const sum=ledger.body.entries.reduce((n,e)=>n+(e.direction===\"CREDIT\"?1:-1)*Number(e.money.amount.replace(\".\",\"\")),0);",
              "      pm.expect(sum).to.eql(Number(balance.replace(\".\",\"\")));",
              "    });",
              "    const rec=await send(urls[0]+\"/wallets/\"+w.id+\"/reconciliation\",\"POST\",internal);",
              "    status(rec,200,\"Reconciliação disponível\");",
              "    pm.test(\"Reconciliação consistente\",()=>{",
              "      pm.expect(rec.body.consistent).to.eql(true);",
              "      pm.expect(rec.body.difference.amount).to.eql(\"0.00\");",
              "      pm.expect(rec.body.storedBalance.amount).to.eql(balance);",
              "      pm.expect(rec.body.calculatedBalance.amount).to.eql(balance);",
              "      pm.expect(rec.body.checkedEntries).to.eql(entries);",
              "    });",
              "    console.log(\"Carteira do cenário\", {walletId:w.id, balance, version, entries, replicas:urls.length});",
              "  }",
              "",
              "  const w=await wallet();",
              "  const ops=[operation(w,\"BET\",\"80.00\"),operation(w,\"BET\",\"80.00\")];",
              "  const results=await Promise.all(ops.map((op,i)=>wager(op,i)));",
              "  pm.test(\"Exatamente uma aceita e uma rejeitada\",()=>{",
              "    pm.expect(results.map(r=>r.code).sort()).to.deep.eql([200,422]);",
              "    pm.expect(results.find(r=>r.code===422).body.failureCode).to.eql(\"INSUFFICIENT_FUNDS\");",
              "  });",
              "  const replays=await Promise.all(ops.map((op,i)=>wager(op,i+1)));",
              "  pm.test(\"Reenvios preservam ambos os resultados\",()=>replays.forEach((r,i)=>{",
              "    pm.expect(r.code).to.eql(results[i].code);",
              "    pm.expect(r.body.idempotentReplay).to.eql(true);",
              "    pm.expect(r.body.transactionId).to.eql(results[i].body.transactionId);",
              "    pm.expect(r.body.balance).to.deep.eql(results[i].body.balance);",
              "    pm.expect(r.body.status).to.eql(results[i].body.status);",
              "    pm.expect(r.body.failureCode).to.eql(results[i].body.failureCode);",
              "  }));",
              "  await verify(w,\"20.00\",2,2);",
              "",
              "})().catch(error => {",
              "  pm.test(\"Cenário terminou sem erro de execução\", () => { throw error; });",
              "});"
            ]
          }
        }
      ]
    },
